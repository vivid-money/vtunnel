{
  "name": "@vivid-money/vtunnel",
  "version": "0.0.0",
  "private": true,
  "description": "The sandbox side of vtunnel in TypeScript, for any runtime with Web Streams; Cloudflare bindings under ./cloudflare",
  "type": "module",
  "exports": {
    "./yamux": "./src/yamux.ts",
    "./frame": "./src/frame.ts",
    "./routes": "./src/routes.ts",
    "./server": "./src/server.ts",
    "./websocket": "./src/websocket.ts",
    "./http1": "./src/http1.ts",
    "./egress": "./src/egress.ts",
    "./cloudflare": "./src/cloudflare/index.ts",
    "./upgrade": "./src/upgrade.ts"
  },
  "scripts": {
    "test": "bun test",
